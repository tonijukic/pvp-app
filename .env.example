# ---- PVP Ops (Pravo v praksi) -------------------------------------------------
# Local dev: leave DATABASE_URL unset -> in-memory storage (zero infra).
# Run:  pnpm install && pnpm dev   (Node 22 recommended; see .nvmrc)

NODE_ENV=development
PORT=5173

# --- Auth ---
SESSION_SECRET=change-me-in-prod
COOKIE_SECURE=false
# Break-glass admin (Nina) — not stored in the DB, can never be locked out.
PVP_ADMIN_USER=nina
PVP_ADMIN_PASS=changeme
PVP_ADMIN_EMAIL=nina@pravovpraksi.si
PVP_ADMIN_NAME=Nina

# --- Database (prod only; unset locally for in-memory) ---
# Neon: postgresql://user:pass@host/db?sslmode=require   (NO channel_binding)
DATABASE_URL=

# --- Email (Phase 1 jobs) ---
# Reuse the workspace Gmail OAuth app. Prototype sends DRAFTS from Toni's account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN_PERSONAL=
GMAIL_REFRESH_TOKEN_BEZIGRAD=
# Long-term: Nina's own token.
# GMAIL_REFRESH_TOKEN_NINA=
PVP_MAIL_ACCOUNT=personal
PVP_DIGEST_TO=nina@pravovpraksi.si
PVP_DIGEST_CC=toni.jukic@gmail.com

# --- Killswitches (OFF by default -> drafts/previews, nothing sent to Nina) ---
PVP_REMINDERS_AUTOSEND=false
PVP_RADAR_AUTOSEND=false

# --- Radar (Phase 2) ---
PVP_RADAR_CADENCE=weekly
# Request under Nina's Pravo v praksi; radar runs on scrape fallback until granted.
PISRS_API_KEY=

# --- Deploy (Render) ---
# APP_BASE_URL=https://pvp-ops.onrender.com
# PVP_RENDER_SERVICE_ID=
