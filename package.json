{
  "name": "pvp-app",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file=.env server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "lint": "eslint server/ client/src/ shared/",
    "lint:fix": "eslint server/ client/src/ shared/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=1 \"server/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "verify": "pnpm check && pnpm lint && pnpm test",
    "db:push": "drizzle-kit push",
    "audit": "pnpm audit --audit-level high",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-select": "2.3.1",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.15",
    "@radix-ui/react-toast": "1.2.17",
    "@radix-ui/react-tooltip": "1.2.10",
    "@tanstack/react-query": "5.101.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.7.1",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "express-session": "^1.19.0",
    "lucide-react": "0.453.0",
    "nanoid": "5.1.11",
    "pg": "8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.79.0",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "web-push": "^3.6.7",
    "wouter": "3.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@eslint/js": "9.39.4",
    "@tailwindcss/typography": "0.5.20",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "20.19.27",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.6.3",
    "typescript-eslint": "8.61.1",
    "vite": "7.3.5"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
