# pnpm config (project uses pnpm — see README "Dependency & security policy").
# pnpm-specific settings (minimumReleaseAge, allowBuilds) live in pnpm-workspace.yaml.

# Pin exact versions on add — no "^"/"~" ranges. With the committed
# pnpm-lock.yaml and `pnpm install --frozen-lockfile`, installs are reproducible.
save-exact=true

# Refuse to install under a Node/pnpm that doesn't match package.json "engines".
engine-strict=true
